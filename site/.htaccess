# ==============================================================
# Suscripción IPTV 8K - Production Apache / LiteSpeed Configuration
# ==============================================================

# 1. CHARACTER ENCODING
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json

# 2. MIME TYPES
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/xml .xml
</IfModule>

# 3. REWRITE ENGINE (HTTPS & CANONICAL REDIRECTS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect WWW to Non-WWW
  RewriteCond %{HTTP_HOST} ^www\.suscripcioniptv8k\.com$ [NC]
  RewriteRule ^(.*)$ https://suscripcioniptv8k.com/$1 [L,R=301]

  # Custom 404 handling
  ErrorDocument 404 /index.html
</IfModule>

# 4. GZIP / BROTLI COMPRESSION (Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. BROWSER CACHING (Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Icons
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS & JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # HTML & XML
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# 6. SECURITY HEADERS
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

